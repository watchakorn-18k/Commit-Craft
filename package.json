{
  "name": "commit-craft-ai",
  "displayName": "CommitCraft — Smart Git AI Assistant",
  "description": "CommitCraft — Smart Git AI Assistant for Commit Messages, Pre-Commit Code Reviews, PR Descriptions & Branch Naming.",
  "version": "0.1.0",
  "engines": {
    "node": ">=16",
    "vscode": "^1.77.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "CommitCraft",
    "commit-craft",
    "commitcraft",
    "Gemini",
    "OpenAI",
    "Claude",
    "DeepSeek",
    "Ollama",
    "Copilot",
    "Groq",
    "OpenRouter",
    "Git",
    "Commit",
    "Code Review",
    "Pull Request",
    "Conventional Commits",
    "Gitmoji",
    "Auto Commit"
  ],
  "publisher": "watchakorn-18k",
  "repository": "https://github.com/watchakorn-18k/Commit-Craft",
  "icon": "images/logo.png",
  "activationEvents": [
    "onStartupFinished",
    "onView:commitcraft.scmView",
    "onView:commitcraft.sidebarView",
    "onCommand:commitcraft.openSettings",
    "onCommand:commitcraft.quickSetup",
    "onCommand:commitcraft.quickMenu",
    "onCommand:commitcraft.generate",
    "onCommand:commitcraft.generateCandidates",
    "onCommand:commitcraft.reviewChanges",
    "onCommand:commitcraft.generatePR",
    "onCommand:commitcraft.generateChangelog",
    "onCommand:commitcraft.suggestBranch"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitcraft-sidebar",
          "title": "CommitCraft",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "commitcraft.scmView",
          "name": "CommitCraft AI Assistant",
          "when": "workbenchState != empty"
        }
      ],
      "commitcraft-sidebar": [
        {
          "id": "commitcraft.sidebarView",
          "name": "CommitCraft Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "commitcraft.generate",
        "icon": "$(sparkle)",
        "title": "CommitCraft: สร้างข้อความ Commit (AI 1-Click)"
      },
      {
        "command": "commitcraft.generateOffline",
        "icon": "$(plug)",
        "title": "CommitCraft: สร้าง Commit แบบออฟไลน์ (Offline Mode)"
      },
      {
        "command": "commitcraft.generateCandidates",
        "icon": "$(list-unordered)",
        "title": "CommitCraft: สร้าง 3 ตัวเลือก Commit (3 Options)"
      },
      {
        "command": "commitcraft.reviewChanges",
        "icon": "$(shield)",
        "title": "CommitCraft: ตรวจทานโค้ดก่อน Commit (Code Review)"
      },
      {
        "command": "commitcraft.generatePR",
        "icon": "$(git-pull-request)",
        "title": "CommitCraft: สร้างคำอธิบาย PR (PR Description)"
      },
      {
        "command": "commitcraft.suggestBranch",
        "icon": "$(git-branch)",
        "title": "CommitCraft: แนะนำชื่อ Branch (Suggest Branch)"
      },
      {
        "command": "commitcraft.generateChangelog",
        "icon": "$(notebook)",
        "title": "CommitCraft: สร้าง/อัปเดต CHANGELOG.md"
      },
      {
        "command": "commitcraft.explainCommit",
        "icon": "$(book)",
        "title": "CommitCraft: อธิบาย Commit นี้ (Explain Commit)"
      },
      {
        "command": "commitcraft.smartStash",
        "icon": "$(archive)",
        "title": "CommitCraft: เก็บโค้ดชั่วคราว (Smart Stash WIP)"
      },
      {
        "command": "commitcraft.popStash",
        "icon": "$(history)",
        "title": "CommitCraft: เรียกคืนโค้ดจาก Stash (Stash Pop)"
      },
      {
        "command": "commitcraft.safeUndo",
        "icon": "$(discard)",
        "title": "CommitCraft: ย้อนกลับ Commit ล่าสุด (Safe Undo)"
      },
      {
        "command": "commitcraft.resolveConflict",
        "icon": "$(git-pull-request-go-to-changes)",
        "title": "CommitCraft: แก้ Merge Conflict ด้วย AI (Resolve Conflicts)"
      },
      {
        "command": "commitcraft.suggestReleaseTag",
        "icon": "$(tag)",
        "title": "CommitCraft: แนะนำเลข Release Tag (SemVer Suggester)"
      },
      {
        "command": "commitcraft.openDashboard",
        "icon": "$(pie-chart)",
        "title": "CommitCraft: เปิดแดชบอร์ดกราฟวงกลม & สถิติ (Visual Dashboard)"
      },
      {
        "command": "commitcraft.translateCommit",
        "icon": "$(globe)",
        "title": "CommitCraft: แปลโน้ตเป็น Conventional Commit (TH → EN Translator)"
      },
      {
        "command": "commitcraft.cleanBranches",
        "icon": "$(trash)",
        "title": "CommitCraft: ลบกิ่งที่ Merge แล้ว (Clean Ghost Branches)"
      },
      {
        "command": "commitcraft.squashSummary",
        "icon": "$(git-merge)",
        "title": "CommitCraft: สรุปรวมหลาย Commit (Squash & Rebase Summarizer)"
      },
      {
        "command": "commitcraft.quickMenu",
        "icon": "$(zap)",
        "title": "CommitCraft: เมนูด่วน (Quick Action Hub)"
      },
      {
        "command": "commitcraft.switchStyle",
        "title": "CommitCraft: สลับสไตล์ Commit (Switch Style)"
      },
      {
        "command": "commitcraft.quickSetup",
        "icon": "$(sparkle)",
        "title": "CommitCraft: ตัวช่วยตั้งค่าด่วน (Setup Wizard)"
      },
      {
        "command": "commitcraft.switchProvider",
        "title": "CommitCraft: สลับผู้ให้บริการ AI (Switch Provider)"
      },
      {
        "command": "commitcraft.selectModel",
        "title": "CommitCraft: เลือกรุ่นโมเดล (Select Model)"
      },
      {
        "command": "commitcraft.setApiKey",
        "title": "CommitCraft: ตั้งค่า API Key (Set API Key)"
      },
      {
        "command": "commitcraft.setBaseUrl",
        "title": "CommitCraft: ตั้งค่า Base URL (Set Base URL)"
      },
      {
        "command": "commitcraft.switchLanguage",
        "title": "CommitCraft: สลับภาษา (Switch Language)"
      },
      {
        "command": "commitcraft.toggleEmoji",
        "title": "CommitCraft: เปิด/ปิด Emojis"
      },
      {
        "command": "commitcraft.openSettings",
        "icon": "$(gear)",
        "title": "CommitCraft: เปิดหน้าตั้งค่า (Open Settings)"
      },
      {
        "command": "commitcraft.showAvailableModels",
        "title": "CommitCraft: แสดงโมเดล OpenAI ที่พร้อมใช้"
      }
    ],
    "keybindings": [
      {
        "command": "commitcraft.generate",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitcraft.generate",
          "group": "navigation@1"
        },
        {
          "command": "commitcraft.generateCandidates",
          "group": "navigation@2"
        },
        {
          "command": "commitcraft.reviewChanges",
          "group": "navigation@3"
        },
        {
          "command": "commitcraft.generatePR",
          "group": "navigation@4"
        },
        {
          "command": "commitcraft.generateChangelog",
          "group": "navigation@5"
        },
        {
          "command": "commitcraft.smartStash",
          "group": "navigation@6"
        },
        {
          "command": "commitcraft.quickMenu",
          "group": "navigation@7"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "commitcraft.reviewChanges",
          "group": "1_commitcraft"
        },
        {
          "command": "commitcraft.generate",
          "group": "1_commitcraft"
        }
      ],
      "editor/context": [
        {
          "command": "commitcraft.resolveConflict",
          "group": "1_commitcraft"
        },
        {
          "command": "commitcraft.reviewChanges",
          "group": "1_commitcraft"
        },
        {
          "command": "commitcraft.generate",
          "group": "1_commitcraft"
        }
      ],
      "view/title": [
        {
          "command": "commitcraft.quickSetup",
          "when": "view == commitcraft.scmView || view == commitcraft.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "commitcraft.openSettings",
          "when": "view == commitcraft.scmView || view == commitcraft.sidebarView",
          "group": "navigation@2"
        }
      ],
      "timeline/item/context": [
        {
          "command": "commitcraft.explainCommit",
          "group": "1_commitcraft"
        }
      ]
    },
    "configuration": {
      "title": "CommitCraft",
      "properties": {
        "commitcraft.AI_PROVIDER": {
          "type": "string",
          "default": "gemini",
          "description": "AI Provider to use (Google Gemini, VS Code LM / Copilot, OpenAI, Claude, DeepSeek, Ollama, OpenRouter, Groq, or Custom)",
          "enum": [
            "gemini",
            "copilot",
            "openai",
            "claude",
            "deepseek",
            "ollama",
            "openrouter",
            "groq",
            "custom"
          ],
          "enumDescriptions": [
            "Google Gemini (Recommended - fast & high quality)",
            "VS Code Language Model / GitHub Copilot (Zero configuration)",
            "OpenAI (GPT-4o, GPT-4o mini, o1, o3-mini)",
            "Anthropic Claude (Claude 3.7 / 3.5 Sonnet & Haiku)",
            "DeepSeek (DeepSeek V3 / R1)",
            "Ollama (Local offline LLMs)",
            "OpenRouter (Access 100+ models)",
            "Groq (Ultra-fast inference)",
            "Custom OpenAI-compatible endpoint"
          ]
        },
        "commitcraft.COMMIT_STYLE": {
          "type": "string",
          "default": "conventional",
          "description": "Commit message formatting style",
          "enum": [
            "conventional",
            "simple",
            "detailed"
          ],
          "enumDescriptions": [
            "Conventional Commits (subject + bullet points)",
            "Simple / One-Liner (concise single line without body)",
            "Detailed (comprehensive changelog with why/how)"
          ]
        },
        "commitcraft.AI_COMMIT_LANGUAGE": {
          "type": "string",
          "default": "English",
          "description": "Language for generated commit messages and PR descriptions",
          "enum": [
            "Thai",
            "English",
            "Simplified Chinese",
            "Traditional Chinese",
            "Japanese",
            "Korean",
            "Spanish",
            "French",
            "German",
            "Portuguese",
            "Russian",
            "Vietnamese",
            "Bahasa",
            "Italian",
            "Polish",
            "Dutch",
            "Turkish",
            "Swedish",
            "Czech"
          ],
          "enumDescriptions": [
            "ไทย",
            "English",
            "简体中文",
            "繁體中文",
            "日本語",
            "한국어",
            "Español",
            "Français",
            "Deutsch",
            "Português",
            "Русский",
            "Tiếng Việt",
            "Bahasa",
            "Italiano",
            "Polski",
            "Nederlands",
            "Türkçe",
            "Svenska",
            "Česky"
          ]
        },
        "commitcraft.DISPLAY_LANGUAGE": {
          "type": "string",
          "default": "th",
          "description": "CommitCraft UI Interface Language (English or ภาษาไทย)",
          "enum": ["th", "en", "zh", "ja"],
          "enumDescriptions": [
            "ภาษาไทย (Thai)",
            "English",
            "简体中文 (Chinese)",
            "日本語 (Japanese)"
          ]
        },
        "commitcraft.EMOJI_ENABLED": {
          "type": "boolean",
          "default": false,
          "description": "Include Gitmoji icons in commit messages (e.g. feat(auth): add login vs ✨ feat(auth): add login)"
        },
        "commitcraft.AUTO_STAGE": {
          "type": "boolean",
          "default": false,
          "description": "Automatically stage all unstaged changes when generating commit messages without confirmation"
        },
        "commitcraft.AUTO_DETECT_ISSUE": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect and extract Issue/Jira tickets from the active git branch name (e.g. feat/PROJ-123-login -> [PROJ-123])"
        },
        "commitcraft.AUTO_DETECT_SCOPE": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect Monorepo, package, and module folder scopes (e.g. apps/web/... -> feat(web): ...)"
        },
        "commitcraft.SHOW_STATUS_BAR": {
          "type": "boolean",
          "default": true,
          "description": "Show the CommitCraft status bar button in VS Code"
        },
        "commitcraft.AI_COMMIT_SYSTEM_PROMPT": {
          "type": "string",
          "default": "",
          "description": "Custom system prompt for commit message generation (leave blank for built-in prompt)"
        },
        "commitcraft.GEMINI_API_KEY": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API Key"
        },
        "commitcraft.GEMINI_MODEL": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Google Gemini Model (e.g. gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)"
        },
        "commitcraft.GEMINI_TEMPERATURE": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Gemini temperature (0-2)"
        },
        "commitcraft.VSCODE_LM_MODEL": {
          "type": "string",
          "default": "copilot/gpt-4o",
          "description": "VS Code Language Model / GitHub Copilot model family"
        },
        "commitcraft.OPENAI_API_KEY": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key"
        },
        "commitcraft.OPENAI_BASE_URL": {
          "type": "string",
          "default": "",
          "description": "Custom OpenAI Base URL (optional)"
        },
        "commitcraft.OPENAI_MODEL": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI Model (e.g. gpt-4o-mini, gpt-4o, o3-mini)"
        },
        "commitcraft.OPENAI_TEMPERATURE": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "OpenAI temperature (0-2)"
        },
        "commitcraft.OPENAI_API_TYPE": {
          "type": "string",
          "default": "completion",
          "description": "OpenAI API Type: Chat Completions or Responses API",
          "enum": ["completion", "response"],
          "enumDescriptions": [
            "Chat Completions API (default)",
            "Responses API (supports reasoning models)"
          ]
        },
        "commitcraft.OPENAI_REASONING_EFFORT": {
          "type": "string",
          "default": "medium",
          "description": "Reasoning effort for Responses API",
          "enum": ["minimal", "low", "medium", "high"]
        },
        "commitcraft.OPENAI_TEXT_VERBOSITY": {
          "type": "string",
          "default": "medium",
          "description": "Output verbosity for Responses API",
          "enum": ["low", "medium", "high"]
        },
        "commitcraft.AZURE_API_VERSION": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI API Version"
        },
        "commitcraft.CLAUDE_API_KEY": {
          "type": "string",
          "default": "",
          "description": "Anthropic Claude API Key"
        },
        "commitcraft.CLAUDE_MODEL": {
          "type": "string",
          "default": "claude-3-7-sonnet-latest",
          "description": "Claude Model (e.g. claude-3-7-sonnet-latest, claude-3-5-sonnet-latest, claude-3-5-haiku-latest)"
        },
        "commitcraft.CLAUDE_TEMPERATURE": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "Claude temperature (0-1)"
        },
        "commitcraft.DEEPSEEK_API_KEY": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key"
        },
        "commitcraft.DEEPSEEK_MODEL": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "DeepSeek Model (deepseek-chat for V3, deepseek-reasoner for R1)"
        },
        "commitcraft.DEEPSEEK_TEMPERATURE": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "DeepSeek temperature (0-2)"
        },
        "commitcraft.OLLAMA_BASE_URL": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Ollama Base URL"
        },
        "commitcraft.OLLAMA_MODEL": {
          "type": "string",
          "default": "llama3.2",
          "description": "Ollama Model (e.g. llama3.2, qwen2.5-coder, deepseek-r1)"
        },
        "commitcraft.OPENROUTER_API_KEY": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API Key"
        },
        "commitcraft.OPENROUTER_MODEL": {
          "type": "string",
          "default": "deepseek/deepseek-chat",
          "description": "OpenRouter Model (e.g. deepseek/deepseek-chat, anthropic/claude-3.5-sonnet)"
        },
        "commitcraft.GROQ_API_KEY": {
          "type": "string",
          "default": "",
          "description": "Groq API Key"
        },
        "commitcraft.GROQ_MODEL": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "description": "Groq Model (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant)"
        },
        "commitcraft.CUSTOM_BASE_URL": {
          "type": "string",
          "default": "http://localhost:8000/v1",
          "description": "Custom OpenAI-compatible Base URL"
        },
        "commitcraft.CUSTOM_API_KEY": {
          "type": "string",
          "default": "",
          "description": "Custom OpenAI-compatible API Key"
        },
        "commitcraft.CUSTOM_MODEL": {
          "type": "string",
          "default": "default",
          "description": "Custom OpenAI-compatible Model name"
        }
      }
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "webpack --mode production --devtool hidden-source-map",
    "compile": "webpack",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "package": "npx @vscode/vsce package --no-dependencies",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "publish": "npx @vscode/vsce publish --no-dependencies",
    "test": "node ./out/test/runTest.js",
    "vscode:prepublish": "npm run build",
    "watch": "webpack --watch",
    "watch-tests": "tsc -p . -w --outDir out"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.77.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.3.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@google/generative-ai": "^0.24.1",
    "fs-extra": "^11.3.4",
    "openai": "^6.36.0",
    "simple-git": "^3.36.0"
  },
  "resolutions": {
    "@types/node": "16.x"
  },
  "license": "MIT"
}
